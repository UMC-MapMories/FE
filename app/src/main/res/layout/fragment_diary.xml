<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/D1_title"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_strip_diary"
    tools:context="com.devdi.mapmories.diary.DiaryFragment">

    <!-- 상단 ToolBar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/Widget.MyTravelDiary.Toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Save 버튼 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="end"/>
    </androidx.appcompat.widget.Toolbar>

    <!-- 선택된 날짜 표시 -->
    <TextView
        android:id="@+id/txtSelectedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025-02-17"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/rakkas"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- 제목, 국기, 위도/경도를 한 줄에 배치 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_location_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txtSelectedDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <!-- 제목 (Title) -->
        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgFlag"
            android:layout_marginEnd="12dp"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/d1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textColor="#6E8F92"
                android:textSize="24sp"
                android:fontFamily="@font/preahvihear"/>

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter title"
                android:textSize="20sp"
                android:minHeight="48dp"
                android:padding="8dp"
                android:background="@color/transparent"
                android:inputType="text"
                android:includeFontPadding="false"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- 국기 (Flag) -->
        <ImageView
            android:id="@+id/imgFlag"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:contentDescription="Flag"
            app:layout_constraintStart_toEndOf="@id/title_layout"
            app:layout_constraintEnd_toStartOf="@id/coordinate_layout"
            app:layout_constraintTop_toTopOf="@id/title_layout"
            android:layout_marginStart="12dp"/>

        <!-- 위도/경도 입력 -->
        <LinearLayout
            android:id="@+id/coordinate_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title_layout">

            <EditText
                android:id="@+id/edtLatitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Lat"
                android:textSize="16sp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:padding="8dp"
                android:inputType="numberSigned|numberDecimal"
                android:fontFamily="@font/preahvihear"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/edtLongitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Lng"
                android:textSize="16sp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:padding="8dp"
                android:inputType="numberSigned|numberDecimal"
                android:fontFamily="@font/preahvihear"
                android:singleLine="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 'Edit your diary' 텍스트 -->
    <TextView
        android:id="@+id/d1_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_diary"
        android:textColor="#6E8F92"
        android:textSize="24sp"
        android:fontFamily="@font/preahvihear"
        app:layout_constraintTop_toBottomOf="@id/title_location_layout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"/>

    <!-- 일기 내용 입력 (Write your diary) -->
    <EditText
        android:id="@+id/edtDiary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Write your diary..."
        android:background="@color/transparent"
        android:inputType="textMultiLine"
        android:textSize="16sp"
        android:minHeight="100dp"
        android:padding="8dp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/d1_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:layout_marginTop="4dp"/>

    <!-- 카메라 버튼 -->
    <!-- 카메라 버튼 -->
    <ImageButton
        android:id="@+id/icCamera"
        android:layout_width="350dp"
        android:layout_height="264dp"
        android:src="@drawable/ic_camera"
        android:contentDescription="@string/open_camera"
        android:background="@color/camerabg"
        app:layout_constraintTop_toBottomOf="@id/edtDiary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <!-- 촬영된 이미지 -->
    <ImageView
        android:id="@+id/imgCamera"
        android:layout_width="350dp"
        android:layout_height="264dp"
        app:layout_constraintTop_toTopOf="@id/icCamera"
        app:layout_constraintStart_toStartOf="@id/icCamera"
        app:layout_constraintEnd_toEndOf="@id/icCamera"
        android:contentDescription="Camera image" />

</androidx.constraintlayout.widget.ConstraintLayout>
