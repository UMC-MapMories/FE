<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:background="#F5F5F5">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/btn_back2"
            android:background="@android:color/transparent"
            android:contentDescription="뒤로가기" />

        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_weight="1" />

        <!-- 코인 아이콘 및 텍스트 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_coin"
            android:layout_marginStart="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 상점 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_rounded2"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- 첫 번째 버튼 (표지) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="표지"
                android:src="@drawable/ic_store_out" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="표지"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 두 번째 버튼 (속지) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="속지"
                android:src="@drawable/ic_store_in" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="속지"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 세 번째 버튼 (폰트) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="폰트"
                android:src="@drawable/ic_store_font" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="폰트"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 네 번째 버튼 (스티커) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="스티커"
                android:src="@drawable/ic_store_sticker" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="스티커"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 다이어리 내용 (ConstraintLayout) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="634dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ic_diary"
        android:padding="16dp">

        <!-- 날짜 텍스트뷰 -->

        <!-- 타이틀 텍스트뷰 -->

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="72dp"
            android:gravity="center"
            android:text="2024. 12. 20 ▼"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Title"
            android:textColor="#6E8F92"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.071"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dateTextView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 하단 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:background="#96B3AF"
        android:padding="16dp"
        android:gravity="center">
    </LinearLayout>
</LinearLayout>
