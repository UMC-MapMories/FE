<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.devdi.mapmories.settings.SettingsViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white">

            <!-- 상단 네비게이션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <!-- 뒤로가기 버튼 (필요시 onClick 처리) -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"/>

                <!-- 오른쪽 사용자 추가 아이콘 -->
                <ImageView
                    android:id="@+id/btnAddFriend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:src="@drawable/friendplus"/>
            </LinearLayout>

            <!-- 프로필 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginVertical="16dp">

                <!-- 프로필 이미지: app:imageUrl 속성을 통해 BindingAdapter로 로드 -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_profile"
                    app:imageUrl="@{viewModel.userProfile != null ? viewModel.userProfile.profileImg : null}"/>

                <!-- 프로필 이름 -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='@{viewModel.userProfile != null ? viewModel.userProfile.name : "이름없음"}'
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

            <!-- 버튼들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:layout_marginBottom="50dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="프로필 수정"
                    android:background="@drawable/rounded_button"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFriendList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_button"
                    android:text="요청 목록"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- 설정 리스트 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/my_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_line"
                    android:padding="16dp"
                    android:text="@string/user_info"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/my_button2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_line"
                    android:padding="16dp"
                    android:text="@string/request_list"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/my_button3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_line"
                    android:padding="16dp"
                    android:text="@string/notifications"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/my_button4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_line"
                    android:padding="16dp"
                    android:text="@string/announcements"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/my_button5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_line"
                    android:padding="16dp"
                    android:text="@string/customer_support"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</layout>
